# OpenAI の API キー（https://platform.openai.com/api-keys で発行）
OPENAI_API_KEY=sk-...

# 文字起こしモデル
TRANSCRIBE_MODEL=gpt-4o-transcribe

# 課題の分析・デモ生成・指示文作成に使うモデル
# 起動時に、このキーで使えるモデルかどうかをチェックしてログに出します
CHAT_MODEL=gpt-5.5

# 推論モデルの考える深さ（low / medium / high）。速さ優先なら low
# 推論モデル以外を使うときは空にしてください
REASONING_EFFORT=low

# ポート番号
PORT=3939
